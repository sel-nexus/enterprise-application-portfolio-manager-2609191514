# Local MongoDB; use an authenticated deployment in production.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=portfolio_manager
# Generate a unique random signing key; never use this example value.
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
CORS_ORIGINS=http://localhost:5173
# Optional initial account; distribute its temporary credential out of band.
BOOTSTRAP_EMAIL=admin@example.com
BOOTSTRAP_NAME=Initial Administrator
BOOTSTRAP_PASSWORD=replace-with-temporary-credential
